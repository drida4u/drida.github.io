/* ═══════════════════════════════════════════════════════════════════
   SMITHA'S JOURNEY — Before Drida (costume designer history)
   ═══════════════════════════════════════════════════════════════════ */
.smitha-journey-section {
  background: var(--paper-alt);
  padding: clamp(4rem, 8vw, 6rem) 0;
  overflow: hidden;
}
.smitha-journey-inner {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 clamp(1.5rem, 5vw, 4rem);
}

/* Header */
.smitha-journey-header {
  text-align: center;
  margin-bottom: 3rem;
}
.smitha-journey-header h2 {
  margin: 0.4rem 0 1rem;
}
.smitha-journey-lead {
  color: var(--muted);
  font-size: 1.08rem;
  max-width: 640px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Story row: text + at-work photos */
.smitha-story-row {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 3rem;
  align-items: start;
  margin-bottom: 3.5rem;
}
.smitha-story-text p {
  color: var(--ink-2);
  line-height: 1.75;
  margin-bottom: 1rem;
  font-size: 0.97rem;
}
.smitha-journey-quote {
  border-left: 3px solid var(--accent);
  padding-left: 1.1rem;
  font-style: italic;
  color: var(--accent) !important;
  font-size: 1rem !important;
  margin-top: 1.5rem !important;
}
/* Banner photo above at-work photos on right side */
.smitha-photo-panel { display: flex; flex-direction: column; gap: 0.75rem; }
.smitha-banner-img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  object-position: top;
  border-radius: 10px;
  box-shadow: var(--shadow);
}
.smitha-atwork-photos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
}
.smitha-atwork-photos img {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
  border-radius: 10px;
  box-shadow: var(--shadow);
}
.smitha-atwork-photos img:first-child {
  margin-top: 1rem; /* offset stagger */
}

/* Gallery */
.smitha-gallery-header {
  margin-bottom: 1.25rem;
  border-bottom: 2px solid var(--line-soft);
  padding-bottom: 0.75rem;
}
.smitha-gallery-header h3 {
  font-size: 1rem;
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0;
}
.smitha-gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  margin-bottom: 3rem;
}
.smitha-gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  box-shadow: var(--shadow);
}
.smitha-gallery-item img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  display: block;
  transition: transform 0.35s ease;
}
.smitha-gallery-item:hover img {
  transform: scale(1.04);
}
.smitha-gallery-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, transparent 100%);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 1.2rem 0.6rem 0.5rem;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.smitha-gallery-item:hover .smitha-gallery-caption {
  opacity: 1;
}

/* Transition line */
.smitha-journey-transition {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  text-align: center;
}
.smitha-transition-line {
  flex: 1;
  height: 1px;
  background: var(--line-soft);
}
.smitha-journey-transition p {
  color: var(--muted);
  font-size: 0.92rem;
  font-style: italic;
  white-space: nowrap;
  margin: 0;
}

/* Drida birth paragraph after transition */
.smitha-drida-birth {
  max-width: 680px;
  margin: 2.5rem auto 0;
  text-align: center;
}
.smitha-drida-birth p {
  color: var(--ink-2);
  line-height: 1.75;
  margin-bottom: 1rem;
  font-size: 0.97rem;
}
.smitha-drida-birth .btn-terra {
  margin-top: 0.5rem;
  display: inline-block;
}

/* Responsive */
@media (max-width: 900px) {
  .smitha-story-row {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .smitha-photo-panel { max-width: 360px; }
  .smitha-atwork-photos img:first-child {
    margin-top: 0;
  }
  .smitha-gallery {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 540px) {
  .smitha-gallery {
    grid-template-columns: repeat(2, 1fr);
  }
  .smitha-journey-transition p {
    white-space: normal;
  }
}
