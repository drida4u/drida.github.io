}
:root[data-theme="pastel-green"] .hero h1 { color: #0e2218; }
:root[data-theme="pastel-green"] .hero p  { color: #2d5a3d; }
:root[data-theme="pastel-green"] .hero-kicker { color: #568a6a; }
:root[data-theme="pastel-green"] .hero-photo::before {
  background: linear-gradient(to right, #e8f5ec 0%, transparent 14%);
}
:root[data-theme="pastel-green"] .hero-ctas .btn-outline {
  color: #0e2218; border-color: rgba(46,138,82,0.40);
}
:root[data-theme="pastel-green"] .hero-page .hero-kicker { color: var(--muted); }
:root[data-theme="pastel-green"] .hero-page h1 { color: var(--ink); }
:root[data-theme="pastel-green"] .hero-page p { color: var(--ink-2); }
