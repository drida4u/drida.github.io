  --grad-h:       linear-gradient(90deg,  #5aac7a 0%, #2e8a52 45%, #1e6e3e 100%);
  --grad-v:       linear-gradient(180deg, #5aac7a 0%, #2e8a52 45%, #1e6e3e 100%);
  --shadow:       0 4px 16px rgba(14,34,24,0.07);
  --shadow-hover: 0 10px 24px rgba(14,34,24,0.13);
}
:root[data-theme="pastel-green"] body {
  background:
    radial-gradient(ellipse 80% 35% at 50% 0%, rgba(46,138,82,0.08) 0%, transparent 65%),
    #f4fbf6;
}
:root[data-theme="pastel-green"] .topbar {
