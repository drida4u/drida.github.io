    rgba( 30,110, 62,0.16) 40%,
    rgba( 15, 80, 40,0.06) 62%,
    transparent 82%);
  box-shadow:
    0 0  70px 28px  rgba( 90,172,122,0.26),
    0 0 150px 65px  rgba( 46,138, 82,0.16),
    0 0 260px 110px rgba( 30,110, 62,0.07),
