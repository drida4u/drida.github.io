:root[data-theme="pastel-green"] #theme-toggle::before { content: "🌿"; font-size: 15px; }

/* ═══════════════════════════════════════════════════════════════════
   TERRA — same warm parchment as light, but gradient ends in a deep
   burnt-sienna rather than bright orange. Tad softer at bottom-right.
   ═══════════════════════════════════════════════════════════════════ */
:root[data-theme="terra"] {
  --paper:       #faf7f3;
  --paper-alt:   #f0ebe3;
  --ink:         #1a1410;
  --ink-2:       #4a3f35;
  --line-soft:   #ddd5c8;
  --muted:       #7a6e64;
  --accent:      #cc2828;
  --accent-dark: #991e1e;
  /* Same red start, but the orange end is pulled back to burnt-sienna */
  --grad:   linear-gradient(135deg, #b52020 0%, #bb3e14 45%, #934010 100%);
  --grad-h: linear-gradient(90deg,  #b52020 0%, #bb3e14 45%, #934010 100%);
  --grad-v: linear-gradient(180deg, #b52020 0%, #bb3e14 45%, #934010 100%);
  --shadow:       0 4px 16px rgba(0,0,0,0.07);
  --shadow-hover: 0 10px 24px rgba(0,0,0,0.13);
}
:root[data-theme="terra"] #theme-toggle::before { content: "🍂"; font-size: 15px; }
:root[data-theme="terra"] .logo-float-bubble {
  background: radial-gradient(ellipse 80% 80% at 50% 50%,
    rgba(185,100, 60,0.72) 0%,
    rgba(165, 80, 40,0.48) 18%,
    rgba(147, 64, 16,0.24) 40%,
    rgba(120, 50, 12,0.08) 62%,
    transparent 82%);
  box-shadow:
    0 0  70px 28px  rgba(185,100, 60,0.30),
    0 0 150px 65px  rgba(165, 80, 40,0.20),
    0 0 260px 110px rgba(147, 64, 16,0.12),
    0 0 400px 150px rgba(120, 50, 12,0.05);
}

