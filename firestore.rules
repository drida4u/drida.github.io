// ============================================================
// FIRESTORE SECURITY RULES
// ------------------------------------------------------------
// Paste into Firebase Console:
// Firestore Database → Rules tab → replace everything → Publish
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the requesting user an admin? ──────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // ── User profiles ─────────────────────────────────────────
    // Users can read/update their own profile.
    // They cannot touch enrolledCourses — only admin can change that.
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('enrolledCourses' in request.resource.data);

      // Own update: phone/lastLogin only — enrolledCourses stays unchanged.
      // Admin update: anything (used by admin dashboard to enroll users).
      allow update: if (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.get('enrolledCourses', []) == resource.data.get('enrolledCourses', []))
        || isAdmin();
    }

    // ── Public course catalogue ───────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Course content (YouTube playlists) ───────────────────
    // Only readable if the user is enrolled in that course.
    match /courseContent/{courseId} {
      allow read: if request.auth != null &&
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enrolledCourses', []);
      allow write: if false;
    }

    // ── Enrollment registrations ──────────────────────────────
    // Users submit their own. Admin reads/manages all.
    match /registrations/{regId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Notify-me requests (coming-soon courses) ──────────────
    match /notify_requests/{reqId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

  }
}
